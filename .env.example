# =====================================================================
#  Evolution API v2.3.7 — configurações. MODELO: copie para .env e preencha (cp .env.example .env).
#  Docs: https://docs.evolutionfoundation.com.br/evolution-api/configuration/env.md
# =====================================================================

# --- Servidor ---------------------------------------------------------
SERVER_TYPE=http
SERVER_PORT=8080
# URL pública da API (usada em links que a Evolution devolve). Será a do ngrok.
SERVER_URL=https://SEU-DOMINIO.ngrok-free.dev

# --- Autenticação -----------------------------------------------------
# Chave global: vai no header "apikey" de toda requisição e no login do /manager.
# Gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=GERE_UMA_CHAVE_FORTE
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- Instâncias -------------------------------------------------------
# false = nunca apagar instância desconectada automaticamente
DEL_INSTANCE=false
LANGUAGE=pt-BR
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# --- Logs -------------------------------------------------------------
LOG_LEVEL=ERROR,WARN,INFO,LOG,WEBHOOKS
LOG_COLOR=true
LOG_BAILEYS=error

# --- Telemetria (envio de estatísticas de uso para os desenvolvedores) -
TELEMETRY_ENABLED=false

# --- PostgreSQL (usado pelo container postgres E pela API) -----------
POSTGRES_DB=evolution
POSTGRES_USER=evolution
# Gere com: openssl rand -hex 24 (e use a mesma na DATABASE_CONNECTION_URI)
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:MESMA_SENHA_DO_POSTGRES_PASSWORD@postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# --- Redis ------------------------------------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# --- Webhook global (desligado: usamos webhook por instância) --------
WEBHOOK_GLOBAL_ENABLED=false

# --- ngrok ------------------------------------------------------------
# Token em https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Domínio estático em https://dashboard.ngrok.com/domains (ex.: algo.ngrok-free.app)
NGROK_DOMAIN=SEU-DOMINIO.ngrok-free.dev

# --- Token do webhook (a Evolution envia no cabeçalho x-webhook-token; o n8n confere) ---
# Gere com: openssl rand -hex 24 e use o mesmo valor na credencial "Evolution webhook" do n8n
WEBHOOK_TOKEN=GERE_UM_TOKEN
